{
  project: {
    id: "muse-project"
    version: "0.1.0"
  }
  render: {
    width: 1920
    height: 1080
    frame_rate: 24
  }
  entries: [
    {
      id: "landscape"
      source: "assets/scenes/landscape.muse"
      outputs: [
        { id: "preview", kind: "preview", path: "library/landscape/preview" }
        { id: "video", kind: "video", format: "mp4", path: "library/landscape/out.mp4" }
      ]
    }
    {
      id: "vertical"
      source: "assets/scenes/vertical.muse"
      render: { width: 1080, height: 1920 }
      outputs: [
        { id: "preview", kind: "preview", path: "library/vertical/preview" }
        { id: "video", kind: "video", format: "mp4", path: "library/vertical/out.mp4" }
      ]
    }
    {
      id: "data"
      source: "assets/scenes/data.muse"
      outputs: [
        { id: "timing", kind: "data", format: "json", path: "library/data/timing.json" }
      ]
    }
  ]
}
