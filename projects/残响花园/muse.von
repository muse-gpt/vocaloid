[project]
id = "残响花园"
version = "0.1.0"
title = "残响花园"
notes = "20s chorus-cut slice: shared music clock, lyric track, landscape + vertical profiles. Original placeholders only."

[render]
width = 1920
height = 1080
frame_rate = 24

[[entries]]
id = "landscape"
source = "assets/scenes/landscape.muse"

[[entries.outputs]]
id = "preview"
kind = "preview"
path = "library/landscape/preview"

[[entries.outputs]]
id = "video"
kind = "video"
format = "mp4"
path = "library/landscape/out.mp4"

[[entries]]
id = "vertical"
source = "assets/scenes/vertical.muse"
render = { width = 1080, height = 1920 }

[[entries.outputs]]
id = "preview"
kind = "preview"
path = "library/vertical/preview"

[[entries.outputs]]
id = "video"
kind = "video"
format = "mp4"
path = "library/vertical/out.mp4"

[[entries]]
id = "data"
source = "assets/scenes/data.muse"

[[entries.outputs]]
id = "timing"
kind = "data"
format = "json"
path = "library/data/timing.json"
