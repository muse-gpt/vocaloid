[project]
id = "残光"
version = "0.1.0"
title = "残光"
notes = "Local effect-alignment project; reference pack under _local_ref/ (gitignored)."

[render]
width = 1920
height = 1080
frame_rate = 24

[[entries]]
id = "landscape"
source = "assets/scenes/landscape.muse"

[[entries.outputs]]
id = "preview"
kind = "preview"
path = "library/landscape/preview"

[[entries.outputs]]
id = "audio-guide"
kind = "audio"
format = "wav"
path = "library/landscape/audio-guide.wav"

[[entries.outputs]]
id = "video"
kind = "video"
format = "mp4"
path = "library/landscape/out.mp4"

[[entries]]
id = "vertical"
source = "assets/scenes/vertical.muse"

[[entries.outputs]]
id = "preview"
kind = "preview"
path = "library/vertical/preview"

[[entries.outputs]]
id = "score"
kind = "score"
format = "musicxml"
path = "library/vertical/score.musicxml"

[[entries]]
id = "data"
source = "assets/scenes/data.muse"

[[entries.outputs]]
id = "timing"
kind = "data"
format = "json"
path = "library/data/timing.json"

[[entries.outputs]]
id = "manifest"
kind = "data"
format = "json"
path = "library/data/shot-manifest.json"
