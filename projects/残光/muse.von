{
  project: {
    id: "残光"
    version: "0.1.0"
    title: "残光"
    notes: "Local effect-alignment project; reference pack under _local_ref/ (gitignored)."
  }
  render: {
    width: 1920
    height: 1080
    frame_rate: 24
  }
  entries: [
    {
      id: "landscape"
      source: "assets/scenes/landscape.muse"
      outputs: [
        { id: "preview", kind: "preview", path: "library/landscape/preview" }
        { id: "audio-guide", kind: "audio", format: "wav", path: "library/landscape/audio-guide.wav" }
        { id: "video", kind: "video", format: "mp4", path: "library/landscape/out.mp4" }
      ]
    }
    {
      id: "vertical"
      source: "assets/scenes/vertical.muse"
      render: { width: 1080, height: 1920 }
      outputs: [
        { id: "preview", kind: "preview", path: "library/vertical/preview" }
        { id: "score", kind: "score", format: "musicxml", path: "library/vertical/score.musicxml" }
      ]
    }
    {
      id: "data"
      source: "assets/scenes/data.muse"
      outputs: [
        { id: "timing", kind: "data", format: "json", path: "library/data/timing.json" }
        { id: "manifest", kind: "data", format: "json", path: "library/data/shot-manifest.json" }
      ]
    }
  ]
}
