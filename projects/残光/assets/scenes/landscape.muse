namespace zanko.landscape;

# 残光 · 16:9 主剪辑（效果对齐：palette 底板 + shot 切 scene 层）
timeline {
  act main : 0..226
  shot s01 : 0..4 scene ember for main
  shot s02 : 4..8 scene illust for main
  shot s03 : 8..16 scene thread for main
}

tempo { at 0 bpm 130.5 }

intent {
  emotion "afterglow city fall" intensity 0.7 for main
}

music for main {
  key "C minor"
  meter 4/4
  motif "C4 Eb4 G4 C5"
  density 0.35
}

visual for main {
  background color "#0b1524"
  image "assets/textures/palette_plate.png"
  lut P2 0.25
  bloom 0.3
  vignette 0.35
  grain 0.06
}

# Shot scene overlays (grade cue until per-scene plates exist).
visual for main scene ember {
  lut P1 0.4
  fx pulse 0.85
}

visual for main scene illust {
  lut P2 0.3
}

visual for main scene thread {
  lut P4 0.35
}

orchestrate for main {
  hard_constraints: ["keep palette readable"]
  soft_preferences: ["slow camera drift"]
}
