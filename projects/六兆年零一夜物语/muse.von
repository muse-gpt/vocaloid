{
  project: {
    id: "六兆年零一夜物语"
    version: "0.1.0"
    title: "六兆年零一夜物语"
    notes: "Design scaffold for kemu/IA track. Copyrighted audio+lyrics stay in _local_ref until licensed. Open tree: structure only. muse.von is true VON (not TOML)."
  }
  render: {
    width: 1920
    height: 1080
    frame_rate: 24
  }
  entries: [
    {
      id: "landscape"
      source: "assets/scenes/landscape.muse"
      outputs: [
        { id: "preview", kind: "preview", path: "library/landscape/preview" }
        { id: "video", kind: "video", format: "mp4", path: "library/landscape/out.mp4" }
      ]
    }
    {
      id: "vertical"
      source: "assets/scenes/vertical.muse"
      render: { width: 1080, height: 1920 }
      outputs: [
        { id: "preview", kind: "preview", path: "library/vertical/preview" }
        { id: "video", kind: "video", format: "mp4", path: "library/vertical/out.mp4" }
      ]
    }
    {
      id: "chorus_cut"
      source: "assets/scenes/chorus_cut.muse"
      outputs: [
        { id: "preview", kind: "preview", path: "library/chorus_cut/preview" }
        { id: "video", kind: "video", format: "mp4", path: "library/chorus_cut/out.mp4" }
      ]
    }
    {
      id: "data"
      source: "assets/scenes/data.muse"
      outputs: [
        { id: "timing", kind: "data", format: "json", path: "library/data/timing.json" }
      ]
    }
  ]
}
